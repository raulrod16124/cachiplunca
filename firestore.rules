rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Autorización efectiva basada en la matriz de ADR-0021
    // (PERMISSION_MATRIX en src/domain/membership/authorization-policy.ts).
    // La UI solo refleja permisos; estas reglas son la frontera de seguridad.

    function signedIn() {
      return request.auth != null;
    }

    function emailVerified() {
      return request.auth.token.email_verified == true;
    }

    function membershipId(workspaceId) {
      return workspaceId + '_' + request.auth.uid;
    }

    function membershipPath(workspaceId) {
      return /databases/$(database)/documents/memberships/$(membershipId(workspaceId));
    }

    function isMember(workspaceId) {
      return signedIn() && exists(membershipPath(workspaceId));
    }

    function roleOf(workspaceId) {
      return get(membershipPath(workspaceId)).data.role;
    }

    function hasRole(workspaceId, roles) {
      return isMember(workspaceId) && roleOf(workspaceId) in roles;
    }

    function workspacePath(workspaceId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId);
    }

    function isWorkspaceCreator(workspaceId) {
      return signedIn() &&
        exists(workspacePath(workspaceId)) &&
        get(workspacePath(workspaceId)).data.createdBy == request.auth.uid;
    }

    function isAcceptingValidInvitation(invitationId, workspaceId, role) {
      return signedIn() &&
        emailVerified() &&
        request.auth.token.email is string &&
        invitationId is string &&
        exists(/databases/$(database)/documents/invitations/$(invitationId)) &&
        get(/databases/$(database)/documents/invitations/$(invitationId)).data.workspaceId == workspaceId &&
        get(/databases/$(database)/documents/invitations/$(invitationId)).data.email == request.auth.token.email.lower() &&
        get(/databases/$(database)/documents/invitations/$(invitationId)).data.role == role &&
        get(/databases/$(database)/documents/invitations/$(invitationId)).data.status == 'pending' &&
        get(/databases/$(database)/documents/invitations/$(invitationId)).data.expiresAt > request.time;
    }

    function canGrantRoleInInvitation(workspaceId, grantedRole) {
      return signedIn() && (
        (grantedRole in ['owner'] && hasRole(workspaceId, ['owner'])) ||
        (grantedRole in ['editor', 'viewer'] && hasRole(workspaceId, ['owner', 'editor']))
      );
    }

    // user_settings: preferencias personales (tema, idioma, tamaño, motion).
    // Solo el propio usuario puede leer y escribir su documento, identificado
    // por su uid. El campo userId debe coincidir para evitar suplantaciones.
    match /user_settings/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.userId == userId;
    }

    // workspaces: lectura limitada a miembros del workspace (ADR-0034).
    // create exige que el creador quede registrado como createdBy para poder
    // crear su membership de owner.
    // update/delete exclusivos de owner.
    match /workspaces/{workspaceId} {
      allow read: if signedIn() && isMember(workspaceId);
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if hasRole(workspaceId, ['owner']);
    }

    // memberships: el rol del usuario en el workspace.
    // read: el propio usuario, miembros del workspace, o get de un doc inexistente
    // (conserva el contrato null de findByUserAndWorkspace).
    // create: solo si el usuario es el creador del workspace (owner-creation) o
    // está aceptando una invitación válida (invitationId anclado y pendiente).
    // update (role): exclusivo de owner, sin poder cambiar userId/workspaceId.
    // delete: el propio usuario (leave) u owner (remove member).
    match /memberships/{membershipId} {
      allow read: if signedIn() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        isMember(resource.data.workspaceId)
      );
      allow create: if signedIn() && (
        (
          isWorkspaceCreator(request.resource.data.workspaceId) &&
          request.resource.data.role == 'owner'
        ) ||
        isAcceptingValidInvitation(
          request.resource.data.invitationId,
          request.resource.data.workspaceId,
          request.resource.data.role
        )
      );
      allow update: if signedIn() && (
        hasRole(resource.data.workspaceId, ['owner']) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.workspaceId == resource.data.workspaceId
      );
      allow delete: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        hasRole(resource.data.workspaceId, ['owner'])
      );
    }

    // elements: escritura solo owner/editor (element:write); los miembros leen.
    // create exige createdBy == uid; update no permite cambiar workspaceId.
    match /elements/{elementId} {
      allow read: if isMember(resource.data.workspaceId);
      allow create: if hasRole(request.resource.data.workspaceId, ['owner', 'editor'])
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if hasRole(resource.data.workspaceId, ['owner', 'editor'])
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if hasRole(resource.data.workspaceId, ['owner', 'editor']);
    }

    // invitations: leer solo miembros del workspace o el destinatario cuyo email
    // coincide. El lookup por tokenHash debe filtrar además por email para que
    // la query sea autorizable. El invitado acepta (pending -> accepted) solo
    // con email verificado y sin tocar el resto de campos.
    // create restringe el rol otorgable según el rol del actor.
    match /invitations/{invitationId} {
      allow read: if signedIn() && (
        resource == null ||
        isMember(resource.data.workspaceId) ||
        (
          request.auth.token.email is string &&
          resource.data.email == request.auth.token.email.lower()
        )
      );
      allow create: if signedIn() &&
        canGrantRoleInInvitation(request.resource.data.workspaceId, request.resource.data.role) &&
        request.resource.data.invitedBy == request.auth.uid;
      allow update: if signedIn() && (
        (
          hasRole(resource.data.workspaceId, ['owner', 'editor']) &&
          request.resource.data.workspaceId == resource.data.workspaceId &&
          request.resource.data.invitedBy == resource.data.invitedBy &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.tokenHash == resource.data.tokenHash
        ) ||
        (
          emailVerified() &&
          request.auth.token.email is string &&
          resource.data.email == request.auth.token.email.lower() &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        )
      );
    }

    // presence: efímera. Solo el dueño del documento la escribe siendo miembro;
    // los miembros la leen.
    match /presence/{presenceId} {
      allow read: if isMember(resource.data.workspaceId);
      allow create, update: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        isMember(request.resource.data.workspaceId);
      allow delete: if signedIn() &&
        resource.data.userId == request.auth.uid &&
        isMember(resource.data.workspaceId);
    }
  }
}
