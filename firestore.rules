rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Autorización efectiva basada en la matriz de ADR-0021
    // (PERMISSION_MATRIX en src/domain/membership/authorization-policy.ts).
    // La UI solo refleja permisos; estas reglas son la frontera de seguridad.

    function signedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return signedIn() &&
        request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function emailVerified() {
      return request.auth.token.email_verified == true;
    }

    function membershipId(workspaceId) {
      return workspaceId + '_' + request.auth.uid;
    }

    function membershipPath(workspaceId) {
      return /databases/$(database)/documents/memberships/$(membershipId(workspaceId));
    }

    function isMember(workspaceId) {
      return signedIn() && exists(membershipPath(workspaceId));
    }

    function isWorkspaceMember(workspaceId, userId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/memberships/$(workspaceId + '_' + userId));
    }

    function roleOf(workspaceId) {
      return get(membershipPath(workspaceId)).data.role;
    }

    function hasRole(workspaceId, roles) {
      return isMember(workspaceId) && roleOf(workspaceId) in roles;
    }

    function workspacePath(workspaceId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId);
    }

    function guestLinkPath(tokenHash) {
      return /databases/$(database)/documents/guest_links/$(tokenHash);
    }

    function guestSessionPath() {
      return /databases/$(database)/documents/guest_sessions/$(request.auth.uid);
    }

    function isGuestViewer(workspaceId) {
      return signedIn() &&
        exists(guestSessionPath()) &&
        get(guestSessionPath()).data.workspaceId == workspaceId &&
        get(guestSessionPath()).data.tokenHash is string &&
        exists(guestLinkPath(get(guestSessionPath()).data.tokenHash)) &&
        get(guestLinkPath(get(guestSessionPath()).data.tokenHash)).data.workspaceId == workspaceId &&
        get(guestLinkPath(get(guestSessionPath()).data.tokenHash)).data.revokedAt == null;
    }

    function isWorkspaceCreator(workspaceId) {
      return signedIn() &&
        exists(workspacePath(workspaceId)) &&
        get(workspacePath(workspaceId)).data.createdBy == request.auth.uid;
    }

    function isAcceptingValidInvitation(invitationId, workspaceId, role) {
      return signedIn() &&
        emailVerified() &&
        request.auth.token.email is string &&
        invitationId is string &&
        exists(/databases/$(database)/documents/invitations/$(invitationId)) &&
        get(/databases/$(database)/documents/invitations/$(invitationId)).data.workspaceId == workspaceId &&
        get(/databases/$(database)/documents/invitations/$(invitationId)).data.email == request.auth.token.email.lower() &&
        get(/databases/$(database)/documents/invitations/$(invitationId)).data.role == role &&
        get(/databases/$(database)/documents/invitations/$(invitationId)).data.status == 'pending' &&
        get(/databases/$(database)/documents/invitations/$(invitationId)).data.expiresAt > request.time;
    }

    function isValidImageData(data) {
      return data.type != 'image' || (
        data.src is string &&
        data.src.size() > 0 &&
        (!('alt' in data) || data.alt is string)
      );
    }

    function canGrantRoleInInvitation(workspaceId, grantedRole) {
      return signedIn() && (
        (grantedRole in ['owner'] && hasRole(workspaceId, ['owner'])) ||
        (grantedRole in ['editor', 'viewer'] && hasRole(workspaceId, ['owner', 'editor']))
      );
    }

    // user_settings: preferencias personales (tema, idioma, tamaño, motion).
    // Solo el propio usuario puede leer y escribir su documento, identificado
    // por su uid. El campo userId debe coincidir para evitar suplantaciones.
    match /user_settings/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.userId == userId;
    }

    // favorites: preferencia privada por usuario y tablero (ADR-0049).
    // El id es determinista (userId_workspaceId), solo el propio usuario puede
    // leer o borrar su favorito y solo se pueden marcar tableros de los que es
    // miembro. La actualización está denegada.
    match /favorites/{favoriteId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() &&
        !isAnonymous() &&
        request.resource.data.keys().hasOnly(['id', 'userId', 'workspaceId', 'createdAt']) &&
        request.resource.data.workspaceId is string &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.id == request.auth.uid + '_' + request.resource.data.workspaceId &&
        request.resource.data.createdAt is timestamp &&
        isMember(request.resource.data.workspaceId);
      allow update: if false;
    }

    // workspaces: lectura limitada a miembros del workspace (ADR-0034) o a
    // guests con un enlace válido. create exige que el creador quede registrado
    // como createdBy para poder crear su membership de owner y rechaza sesiones
    // anónimas. update de metadatos y delete exclusivos de owner; owner/editor
    // pueden actualizar únicamente lastActivityAt.
    match /workspaces/{workspaceId} {
      allow read: if isMember(workspaceId) || isGuestViewer(workspaceId);
      allow create: if signedIn() &&
        !isAnonymous() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.name.trim().size() >= 1 &&
        request.resource.data.name.trim().size() <= 100 &&
        (!('description' in request.resource.data) ||
          request.resource.data.description == null ||
          request.resource.data.description is string) &&
        (!('coverImageUrl' in request.resource.data) ||
          request.resource.data.coverImageUrl == null ||
          request.resource.data.coverImageUrl is string) &&
        (!('coverImageStoragePath' in request.resource.data) ||
          request.resource.data.coverImageStoragePath == null ||
          request.resource.data.coverImageStoragePath is string) &&
        (!('type' in request.resource.data) ||
          (request.resource.data.type is string &&
            (request.resource.data.type == 'general' ||
              request.resource.data.type == 'work' ||
              request.resource.data.type == 'travel' ||
              request.resource.data.type == 'tasks' ||
              request.resource.data.type == 'ideas')));
      allow update: if (hasRole(workspaceId, ['owner']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'description',
          'coverImageUrl',
          'coverImageStoragePath',
          'type',
          'updatedAt',
          'lastActivityAt'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.name.trim().size() >= 1 &&
        request.resource.data.name.trim().size() <= 100 &&
        (!('description' in request.resource.data) ||
          request.resource.data.description == null ||
          request.resource.data.description is string) &&
        ((request.resource.data.get('coverImageUrl', null) == null &&
          request.resource.data.get('coverImageStoragePath', null) == null) ||
          (request.resource.data.get('coverImageUrl', null) is string &&
            request.resource.data.get('coverImageStoragePath', null) is string &&
            request.resource.data.get('coverImageUrl', null).matches('^https?://.+') &&
            request.resource.data
              .get('coverImageStoragePath', null)
              .matches('^workspaces/' + workspaceId + '/images/.+'))) &&
        ((resource.data.get('type', null) == null &&
          !('type' in request.resource.data)) ||
          (request.resource.data.get('type', null) is string &&
            (request.resource.data.get('type', null) == 'general' ||
              request.resource.data.get('type', null) == 'work' ||
              request.resource.data.get('type', null) == 'travel' ||
              request.resource.data.get('type', null) == 'tasks' ||
              request.resource.data.get('type', null) == 'ideas'))) &&
        (!('updatedAt' in request.resource.data) ||
          (request.resource.data.updatedAt is timestamp &&
            request.resource.data.updatedAt >= resource.data.createdAt)) &&
        (!('lastActivityAt' in request.resource.data) ||
          (request.resource.data.lastActivityAt is timestamp &&
            request.resource.data.lastActivityAt >= resource.data.createdAt))) || (
        hasRole(workspaceId, ['owner', 'editor']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActivityAt']) &&
        request.resource.data.lastActivityAt is timestamp &&
        request.resource.data.lastActivityAt >= resource.data.createdAt
      );
      allow delete: if hasRole(workspaceId, ['owner']);
    }

    // memberships: el rol del usuario en el workspace.
    // read: el propio usuario, miembros del workspace, o get de un doc inexistente
    // (conserva el contrato null de findByUserAndWorkspace).
    // create: solo si el usuario es el creador del workspace (owner-creation) o
    // está aceptando una invitación válida (invitationId anclado y pendiente).
    // update (role): exclusivo de owner, sin poder cambiar userId/workspaceId.
    // delete: el propio usuario (leave) u owner (remove member).
    match /memberships/{membershipId} {
      allow read: if signedIn() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        isMember(resource.data.workspaceId)
      );
      allow create: if signedIn() && (
        (
          isWorkspaceCreator(request.resource.data.workspaceId) &&
          request.resource.data.role == 'owner'
        ) ||
        isAcceptingValidInvitation(
          request.resource.data.invitationId,
          request.resource.data.workspaceId,
          request.resource.data.role
        )
      );
      allow update: if signedIn() && (
        hasRole(resource.data.workspaceId, ['owner']) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.workspaceId == resource.data.workspaceId
      );
      allow delete: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        hasRole(resource.data.workspaceId, ['owner'])
      );
    }

    // elements: escritura solo owner/editor (element:write); los miembros y los
    // guests con enlace válido leen. create exige createdBy == uid; update no
    // permite cambiar workspaceId.
    match /elements/{elementId} {
      allow read: if isMember(resource.data.workspaceId) ||
        isGuestViewer(resource.data.workspaceId);
      allow create: if hasRole(request.resource.data.workspaceId, ['owner', 'editor'])
        && request.resource.data.createdBy == request.auth.uid
        && isValidImageData(request.resource.data);
      allow update: if hasRole(request.resource.data.workspaceId, ['owner', 'editor'])
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.createdBy == resource.data.createdBy
        && isValidImageData(request.resource.data);
      allow delete: if hasRole(resource.data.workspaceId, ['owner', 'editor']);
    }

    // invitations: leer solo miembros del workspace o el destinatario cuyo email
    // coincide. El lookup por tokenHash debe filtrar además por email para que
    // la query sea autorizable. El invitado acepta (pending -> accepted) solo
    // con email verificado y sin tocar el resto de campos.
    // create restringe el rol otorgable según el rol del actor.
    match /invitations/{invitationId} {
      allow read: if signedIn() && (
        resource == null ||
        isMember(resource.data.workspaceId) ||
        (
          request.auth.token.email is string &&
          resource.data.email == request.auth.token.email.lower()
        )
      );
      allow create: if signedIn() &&
        canGrantRoleInInvitation(request.resource.data.workspaceId, request.resource.data.role) &&
        request.resource.data.invitedBy == request.auth.uid;
      allow update: if signedIn() && (
        (
          hasRole(resource.data.workspaceId, ['owner', 'editor']) &&
          request.resource.data.workspaceId == resource.data.workspaceId &&
          request.resource.data.invitedBy == resource.data.invitedBy &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.tokenHash == resource.data.tokenHash
        ) ||
        (
          emailVerified() &&
          request.auth.token.email is string &&
          resource.data.email == request.auth.token.email.lower() &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        )
      );
    }

    // guest_links: enlaces de solo lectura. El id es el hash SHA-256 del token,
    // por lo que un get por id funciona como capability no adivinable. El list
    // queda reservado a miembros (la UI de owner lista el enlace activo). Solo
    // el owner crea y revoca; el enlace no se puede borrar ni des-revocar.
    match /guest_links/{tokenHash} {
      allow get: if true;
      allow list: if signedIn() && hasRole(resource.data.workspaceId, ['owner']);
      allow create: if signedIn() &&
        tokenHash.matches('^[a-f0-9]{64}$') &&
        hasRole(request.resource.data.workspaceId, ['owner']) &&
        request.resource.data.role == 'viewer' &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.revokedAt == null;
      allow update: if signedIn() &&
        hasRole(resource.data.workspaceId, ['owner']) &&
        resource.data.revokedAt == null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'revokedAt',
          'updatedAt'
        ]) &&
        request.resource.data.revokedAt is timestamp;
      allow delete: if false;
    }

    // guest_sessions: sesión efímera que vincula un uid (normalmente anónimo)
    // con un enlace activo. Crear o actualizar exige conocer el tokenHash del
    // enlace y que este siga activo; así el workspaceId no se puede falsificar.
    match /guest_sessions/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.userId == userId &&
        request.resource.data.tokenHash is string &&
        request.resource.data.tokenHash.matches('^[a-f0-9]{64}$') &&
        exists(guestLinkPath(request.resource.data.tokenHash)) &&
        get(guestLinkPath(request.resource.data.tokenHash)).data.revokedAt == null &&
        get(guestLinkPath(request.resource.data.tokenHash)).data.workspaceId ==
          request.resource.data.workspaceId;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // notifications: avisos persistentes por destinatario. Solo el destinatario
    // lee y marca como leída su notificación. Cualquier miembro puede crear
    // avisos de comentario en nombre propio, nunca para sí mismo, y solo si el
    // destinatario también pertenece al workspace.
    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if signedIn() &&
        request.resource.data.id == notificationId &&
        request.resource.data.type == 'comment' &&
        request.resource.data.actorId == request.auth.uid &&
        request.resource.data.recipientId is string &&
        request.resource.data.recipientId != request.auth.uid &&
        request.resource.data.workspaceId is string &&
        request.resource.data.workspaceName is string &&
        request.resource.data.elementId is string &&
        request.resource.data.commentId is string &&
        request.resource.data.actorName is string &&
        request.resource.data.bodyPreview is string &&
        request.resource.data.bodyPreview.size() > 0 &&
        request.resource.data.bodyPreview.size() <= 140 &&
        request.resource.data.createdAt is timestamp &&
        !('readAt' in request.resource.data) &&
        isMember(request.resource.data.workspaceId) &&
        isWorkspaceMember(
          request.resource.data.workspaceId,
          request.resource.data.recipientId
        );
      allow update: if signedIn() &&
        resource.data.recipientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']) &&
        request.resource.data.readAt is timestamp &&
        request.resource.data.readAt >= resource.data.createdAt;
      allow delete: if false;
    }

    // comments: colaboración asíncrona ligada a elementos. Solo los miembros
    // del workspace leen y crean; cualquier miembro puede resolver. El autor
    // puede editar el cuerpo durante los primeros 15 minutos. Resolver solo
    // puede añadir resolvedAt y conserva el resto del historial.
    match /workspaces/{workspaceId}/comments/{commentId} {
      allow read: if signedIn() && isMember(workspaceId);
      allow create: if signedIn() &&
        isMember(workspaceId) &&
        request.resource.data.workspaceId == workspaceId &&
        request.resource.data.id == commentId &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.body is string &&
        !('resolvedAt' in request.resource.data) &&
        !('editedAt' in request.resource.data);
      allow update: if signedIn() &&
        isMember(workspaceId) &&
        resource.data.workspaceId == workspaceId &&
        !('resolvedAt' in resource.data) &&
        (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolvedAt']) &&
            request.resource.data.resolvedAt is timestamp
          ) ||
          (
            request.auth.uid == resource.data.authorId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'editedAt']) &&
            request.resource.data.diff(resource.data).affectedKeys().hasAll(['body', 'editedAt']) &&
            request.resource.data.body is string &&
            request.resource.data.body.size() > 0 &&
            request.resource.data.body.size() <= 4000 &&
            request.resource.data.editedAt is timestamp &&
            request.resource.data.editedAt.toMillis() >= resource.data.createdAt.toMillis() &&
            request.resource.data.editedAt.toMillis() <= request.time.toMillis() &&
            request.time.toMillis() >= resource.data.createdAt.toMillis() &&
            request.time.toMillis() - resource.data.createdAt.toMillis() <= 900000
          )
        );
      allow delete: if false;
    }

    // presence: efímera. Solo el dueño del documento la escribe siendo miembro;
    // los miembros la leen.
    match /presence/{presenceId} {
      allow read: if isMember(resource.data.workspaceId);
      allow create, update: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        isMember(request.resource.data.workspaceId);
      allow delete: if signedIn() &&
        resource.data.userId == request.auth.uid &&
        isMember(resource.data.workspaceId);
    }
  }
}
