{
  "name": "cachiplunca",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:fix": "oxlint --fix",
    "test": "jest --runInBand",
    "verify": "bash scripts/verify.sh",
    "jira": "node scripts/jira.mjs",
    "jira:list": "node scripts/jira.mjs list",
    "jira:next": "node scripts/jira.mjs next",
    "jira:card": "node scripts/jira.mjs card",
    "jira:validate": "node scripts/jira.mjs validate",
    "test:jira": "node --test scripts/jira-selector.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-cachiplunca \"jest --config jest.rules.config.cjs --runInBand\"",
    "perf": "node --expose-gc ./node_modules/jest/bin/jest.js --config jest.perf.config.cjs --runInBand",
    "perf:dev": "vite --open /perf.html",
    "test:e2e": "firebase emulators:exec --only auth,firestore,storage --project demo-cachiplunca \"playwright test\"",
    "test:e2e:ui": "firebase emulators:exec --only auth,firestore,storage --project demo-cachiplunca \"playwright test --ui\"",
    "test:e2e:headed": "firebase emulators:exec --only auth,firestore,storage --project demo-cachiplunca \"playwright test --headed\""
  },
  "engines": {
    "node": "22",
    "npm": ">=10"
  },
  "dependencies": {
    "@raulrod/tokens": "^1.0.0",
    "@raulrod/ui": "^1.2.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-bold": "^3.32.0",
    "@tiptap/extension-bullet-list": "^3.32.0",
    "@tiptap/extension-document": "^3.32.0",
    "@tiptap/extension-heading": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-history": "^3.32.0",
    "@tiptap/extension-italic": "^3.32.0",
    "@tiptap/extension-list-item": "^3.32.0",
    "@tiptap/extension-ordered-list": "^3.32.0",
    "@tiptap/extension-paragraph": "^3.32.0",
    "@tiptap/extension-strike": "^3.32.0",
    "@tiptap/extension-text": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "firebase": "^12.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^14.27.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "re2js": "^2.9.1"
  }
}
