{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "docs/architecture.md"],
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git switch*": "allow",
      "npm test*": "allow",
      "npm run lint": "allow",
      "npm run format:check": "allow",
      "npm run verify*": "allow",
      "npm run jira*": "allow",
      "npm run test:rules": "allow",
      "npm run test:e2e*": "allow",
      "npm run perf": "allow",
      "npm run build*": "allow",
      "npx tsc*": "allow",
      "npx playwright*": "allow",
      "node scripts/jira.mjs*": "allow",
      "bash scripts/e2e.sh*": "allow",
      "rg *": "allow",
      "git commit*": "ask",
      "git push*": "deny",
      "firebase deploy*": "deny",
      "rm *": "deny",
    },
  },
}
